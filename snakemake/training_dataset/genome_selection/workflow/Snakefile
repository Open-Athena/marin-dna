from marin_dna_genome_selection.selection import (
    add_taxonomy_to_genomes,
    extract_tax_ids,
    filter_genomes_file,
)


configfile: "config/config.yaml"


rule all:
    input:
        "results/genomes/filtered.parquet",


rule download_genome_list:
    output:
        "results/genomes/all.raw.tsv",
    conda:
        "envs/ncbi_datasets.yaml"
    shell:
        """
        datasets summary genome taxon {config[taxon]} \
            --as-json-lines --reference --annotated --exclude-atypical --assembly-source RefSeq \
            | dataformat tsv genome \
                --fields \
                accession,assminfo-name,organism-name,organism-tax-id,assminfo-level,assmstats-total-sequence-len \
                >{output}
        """


rule extract_tax_ids:
    input:
        "results/genomes/all.raw.tsv",
    output:
        "results/tax_ids.txt",
    run:
        extract_tax_ids(input[0], output[0])


# takes half an hour to run for metazoa
rule download_taxonomy:
    input:
        "results/tax_ids.txt",
    output:
        "results/taxonomy.jsonl",
    conda:
        "envs/ncbi_datasets.yaml"
    shell:
        "datasets summary taxonomy taxon --inputfile {input} --as-json-lines > {output}"


rule add_taxonomy_to_genomes:
    input:
        "results/genomes/all.raw.tsv",
        "results/taxonomy.jsonl",
    output:
        "results/genomes/all.parquet",
    run:
        add_taxonomy_to_genomes(input[0], input[1], output[0])


rule filter_genomes:
    input:
        "results/genomes/all.parquet",
    output:
        "results/genomes/filtered.parquet",
    run:
        filter_genomes_file(
            input[0],
            output[0],
            exclude_genomes=config["exclude_genomes"],
            deduplicate_taxonomic_rank=config["deduplicate_taxonomic_rank"],
            min_assembly_level=config["min_assembly_level"],
            max_genome_size=config["max_genome_size"],
            priority_genomes=config["priority_genomes"],
        )
