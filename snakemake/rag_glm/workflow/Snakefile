"""Issue #402 fixed-layout RAG dataset pipeline."""

import os


configfile: "config/config.yaml"


N_TRAINING_SHARDS = int(config["training_n_shards"])
TRAINING_SHARDS = [
    f"part-{index:05d}-of-{N_TRAINING_SHARDS:05d}.parquet"
    for index in range(N_TRAINING_SHARDS)
]
TRAINING_DATASET_DIR = "results/dataset/zoonomia-rag-v1-v1"
NON_HUMAN_SPECIES = tuple(config["species_order"][:-1])
MENDELIAN_WORK_DIR = "results/mendelian"
MENDELIAN_DATASET_DIR = (
    f"{MENDELIAN_WORK_DIR}/dataset/evals_mendelian_traits_rag_harness_255_v1"
)
MENDELIAN_INTERVALS = expand(
    f"{MENDELIAN_WORK_DIR}/mapping/intervals/{{species}}.parquet",
    species=NON_HUMAN_SPECIES,
)
MENDELIAN_SEQUENCES = expand(
    f"{MENDELIAN_WORK_DIR}/sequences/{{species}}.parquet",
    species=NON_HUMAN_SPECIES,
)
COMMIT_SHA = str(config.get("commit_sha") or os.environ.get("COMMIT_SHA") or "")


rule species_audit:
    """Audit candidate projection coverage, ambiguity, and panel redundancy."""
    output:
        statistics="results/audit/species_statistics.tsv",
        pairwise="results/audit/panel_pairwise_identity.tsv",
        sample_ids="results/audit/sample_anchor_ids.txt",
        summary="results/audit/summary.json",
    threads: 1
    resources:
        mem_mb=32000,
    params:
        source_parquet=config["upstream_projection_parquet"],
        species_tsv=config["species_tsv"],
        sample_size=int(config["audit_sample_size"]),
        sample_seed=int(config["audit_sample_seed"]),
        panel=tuple(config["species_order"]),
    run:
        from marin_dna.pipelines.rag_glm.audit import run_species_audit

        run_species_audit(
            source_parquet=params.source_parquet,
            species_tsv=params.species_tsv,
            statistics_path=output.statistics,
            pairwise_path=output.pairwise,
            sample_ids_path=output.sample_ids,
            summary_path=output.summary,
            sample_size=params.sample_size,
            sample_seed=params.sample_seed,
            panel=params.panel,
        )


rule build_training_dataset:
    """Pivot the frozen projection into train/validation document shards."""
    output:
        training=expand(
            f"{TRAINING_DATASET_DIR}/data/train/{{shard}}",
            shard=TRAINING_SHARDS,
        ),
        validation=f"{TRAINING_DATASET_DIR}/data/validation/part-00000-of-00001.parquet",
        manifest=f"{TRAINING_DATASET_DIR}/manifest.json",
        readme=f"{TRAINING_DATASET_DIR}/README.md",
    threads: 4
    resources:
        mem_mb=110000,
    params:
        source_parquet=config["upstream_projection_parquet"],
        species_order=tuple(config["species_order"]),
        species_order_version=config["species_order_version"],
        validation_size=int(config["validation_size"]),
        validation_seed=int(config["validation_seed"]),
        shuffle_seed=int(config["training_shuffle_seed"]),
        commit_sha=COMMIT_SHA,
        hf_repo=config["hf_training_repo"],
    run:
        from marin_dna.pipelines.rag_glm.dataset import materialize_training_dataset

        materialize_training_dataset(
            source_parquet=params.source_parquet,
            training_shard_paths=list(output.training),
            validation_path=output.validation,
            manifest_path=output.manifest,
            readme_path=output.readme,
            species_order=params.species_order,
            species_order_version=params.species_order_version,
            validation_size=params.validation_size,
            validation_seed=params.validation_seed,
            shuffle_seed=params.shuffle_seed,
            commit_sha=params.commit_sha,
            hf_repo=params.hf_repo,
        )


rule upload_training_dataset:
    """Upload the reviewed training dataset card and Parquet splits to HF."""
    input:
        rules.build_training_dataset.output,
    output:
        touch("results/upload.done/zoonomia-rag-v1-v1"),
    threads: 4
    params:
        repo=config["hf_training_repo"],
        dataset_dir=TRAINING_DATASET_DIR,
        local_dataset_dir=f".snakemake/storage/s3/oa-bolinas/snakemake/rag_glm/{TRAINING_DATASET_DIR}",
    shell:
        """
        test -d {params.local_dataset_dir}
        hf upload-large-folder {params.repo} --repo-type dataset {params.local_dataset_dir}
        mkdir -p $(dirname {output})
        touch {output}
        """


rule build_mendelian_projection_mapping:
    """Map arbitrary SNVs through containing immutable projection anchors."""
    output:
        mapping=f"{MENDELIAN_WORK_DIR}/mapping/variants.parquet",
        intervals=MENDELIAN_INTERVALS,
        audit=f"{MENDELIAN_WORK_DIR}/mapping/audit.json",
    threads: 2
    resources:
        mem_mb=64000,
    params:
        source_harness_urls=tuple(config["source_mendelian_harness"].values()),
        projection_parquet=config["upstream_projection_parquet"],
        species_order=tuple(config["species_order"]),
    run:
        from marin_dna.pipelines.rag_glm.mendelian_harness import (
            build_mendelian_projection_mapping,
        )

        build_mendelian_projection_mapping(
            source_harness_urls=params.source_harness_urls,
            projection_parquet=params.projection_parquet,
            mapping_path=output.mapping,
            interval_paths=dict(
                zip(NON_HUMAN_SPECIES, output.intervals, strict=True)
            ),
            audit_path=output.audit,
            species_order=params.species_order,
        )


rule extract_mendelian_orthologs:
    """Extract and orient centered windows from archived species 2bit genomes."""
    input:
        twobit=lambda wc: storage(
            f"{config['upstream_species_twobit_prefix']}/{wc.species}.2bit"
        ),
        intervals=f"{MENDELIAN_WORK_DIR}/mapping/intervals/{{species}}.parquet",
    output:
        f"{MENDELIAN_WORK_DIR}/sequences/{{species}}.parquet",
    threads: 1
    resources:
        mem_mb=2000,
    run:
        from marin_dna.pipelines.rag_glm.mendelian_harness import (
            extract_ortholog_sequences_from_twobit,
        )

        extract_ortholog_sequences_from_twobit(
            input.intervals,
            input.twobit,
            output[0],
        )


rule build_mendelian_rag_harness:
    """Assemble the one-row-per-variant-per-strand frozen RAG harness."""
    input:
        mapping=f"{MENDELIAN_WORK_DIR}/mapping/variants.parquet",
        sequences=MENDELIAN_SEQUENCES,
    output:
        train=f"{MENDELIAN_DATASET_DIR}/train.parquet",
        test=f"{MENDELIAN_DATASET_DIR}/test.parquet",
        manifest=f"{MENDELIAN_DATASET_DIR}/manifest.json",
        readme=f"{MENDELIAN_DATASET_DIR}/README.md",
    threads: 2
    resources:
        mem_mb=32000,
    params:
        source_harness_urls=dict(config["source_mendelian_harness"]),
        commit_sha=COMMIT_SHA,
        hf_repo=config["hf_mendelian_repo"],
        species_order=tuple(config["species_order"]),
    run:
        from marin_dna.pipelines.rag_glm.mendelian_harness import (
            materialize_mendelian_rag_harness,
        )

        materialize_mendelian_rag_harness(
            source_harness_urls=params.source_harness_urls,
            mapping_path=input.mapping,
            species_sequence_paths=dict(
                zip(NON_HUMAN_SPECIES, input.sequences, strict=True)
            ),
            output_split_paths={"train": output.train, "test": output.test},
            manifest_path=output.manifest,
            readme_path=output.readme,
            commit_sha=params.commit_sha,
            hf_repo=params.hf_repo,
            species_order=params.species_order,
        )


rule upload_mendelian_rag_harness:
    """Upload the reviewed, fully materialized RAG evaluation harness."""
    input:
        rules.build_mendelian_rag_harness.output,
    output:
        touch(
            f"{MENDELIAN_WORK_DIR}/upload.done/evals_mendelian_traits_rag_harness_255_v1"
        ),
    threads: 4
    params:
        repo=config["hf_mendelian_repo"],
        local_dataset_dir=(
            ".snakemake/storage/s3/oa-bolinas/snakemake/rag_glm/"
            f"{MENDELIAN_DATASET_DIR}"
        ),
    shell:
        """
        test -d {params.local_dataset_dir}
        hf upload-large-folder {params.repo} --repo-type dataset {params.local_dataset_dir}
        mkdir -p $(dirname {output})
        touch {output}
        """
