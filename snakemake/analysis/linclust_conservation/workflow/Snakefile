        """


rule stage_genome:
    input:
        selection=local(SELECTION_PATH),
        reuse=local(SOURCE_REUSE_PATH),
    output:
        f"{SMOKE}/staging/{{accession}}.json",
    wildcard_constraints:
        accession="|".join(ACCESSIONS).replace(".", r"\."),
    conda:
        "envs/genome_tools.yaml"
    resources:
        mem_mb=3000,
        staging_jobs=1,
    params:
        destination=lambda wildcards: staging_destination(wildcards.accession),
        source_options=lambda wildcards: staging_source_options(wildcards.accession),
    shell:
        "linclust-conservation-stage-genome --accession {wildcards.accession:q} "
        "--destination-uri {params.destination:q} {params.source_options} "
        "--output {output:q}"


rule sample_genome_windows:
    input:
        staging=f"{SMOKE}/staging/{{accession}}.json",
        sequence_report=f"{MANIFEST}/sequence_report.jsonl",
    output:
        fasta=f"{SMOKE}/windows/{{accession}}.fasta",
        stats=f"{SMOKE}/windows/{{accession}}.json",
    conda:
        "envs/genome_tools.yaml"
    resources:
        mem_mb=3000,
        sampling_jobs=1,
    params:
        length=config["window"]["length"],
        stride=config["window"]["stride"],
        repeat=config["window"]["max_repeat_fraction"],
        candidate_selection=candidate_selection_options(),
        batch_size=config["smoke"]["batch_size"],
        seed=config["smoke"]["seed"],
    shell:
        "linclust-conservation-sample-genome "
        "--accession {wildcards.accession:q} "
        "--sequence-report {input.sequence_report:q} "
        "--staging-receipt {input.staging:q} "
        "--window-length {params.length} --stride {params.stride} "
        "{params.candidate_selection} --batch-size {params.batch_size} "
        "--seed {params.seed} "
        "--max-repeat-fraction {params.repeat} "
        "--output-fasta {output.fasta:q} --output-stats {output.stats:q}"


rule combine_smoke_windows:
    input:
        expand(f"{SMOKE}/windows/{{accession}}.fasta", accession=ACCESSIONS),
    output:
        f"{SMOKE}/windows.fasta",
    run:
        Path(output[0]).parent.mkdir(parents=True, exist_ok=True)
        with Path(output[0]).open("wb") as destination:
            for path in input:
                with Path(path).open("rb") as source:
                    shutil.copyfileobj(source, destination)


rule finalize_staged_manifest:
    input:
        selection=local(SELECTION_PATH),
        staging=expand(f"{SMOKE}/staging/{{accession}}.json", accession=ACCESSIONS),
        stats=expand(f"{SMOKE}/windows/{{accession}}.json", accession=ACCESSIONS),
    output:
        f"{SMOKE}/assembly_manifest.tsv",
    run:
        staged = {
            json.loads(Path(path).read_text())["accession"]: json.loads(
                Path(path).read_text()
            )
            for path in input.staging
        }
        stats = {
            json.loads(Path(path).read_text())["accession"]: json.loads(
                Path(path).read_text()
            )
            for path in input.stats
        }
        rows = []
        for row in pl.read_csv(input.selection, separator="\t").to_dicts():
            accession = row["accession"]
            receipt = staged[accession]
            row.update(
                {
                    "download_uri": receipt["destination_uri"],
                    "source_checksum_type": "sha256",
                    "source_checksum": stats[accession]["sequence_sha256"],
                    "source_size_bytes": receipt["destination_size_bytes"],
                    "sequence_sha256": stats[accession]["sequence_sha256"],
                }
            )
            rows.append(row)
        manifest = pl.DataFrame(rows).select(MANIFEST_COLUMNS)
        validate_pinned_manifest(manifest)
        manifest.write_csv(output[0], separator="\t")


rule run_smoke_linclust:
    input:
        fasta=f"{SMOKE}/windows.fasta",
    output:
        assignments=f"{SMOKE}/clusters.tsv",
        alignments=f"{SMOKE}/alignments.tsv",
        version=f"{SMOKE}/mmseqs_version.txt",
        resources=f"{SMOKE}/resources.txt",
        peak_temporary_bytes=f"{SMOKE}/peak_temporary_bytes.txt",
    conda:
        "envs/mmseqs2.yaml"
    threads: 2
    resources:
        mem_mb=6000,
    params:
        min_id=MMSEQS["min_sequence_identity"],
        coverage=MMSEQS["coverage"],
        cov_mode=MMSEQS["coverage_mode"],
        evalue=MMSEQS["evalue"],
        kmers=MMSEQS["kmers_per_sequence"],
        spaced=MMSEQS["spaced_kmer_mode"],
        mask_lower=MMSEQS["mask_lower_case"],
        mask=MMSEQS["low_complexity_masking"],
        cluster_mode=MMSEQS["cluster_mode"],
        max_alignments=SMOKE_MAX_WINDOWS,
        alignment_kmer=MMSEQS["alignment_kmer_length"],
        split_memory=MMSEQS["alignment_split_memory_limit"],
    shell:
        r"""
        set -euo pipefail
        TMPDIR=$(mktemp -d -t linclust_smoke_XXXXXX)
        trap 'rm -rf "$TMPDIR"' EXIT
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        mmseqs version >{output.version}
        /usr/bin/time -v -o {output.resources} \
            mmseqs createdb {input.fasta} "$TMPDIR/sequences" \
            --mask-lower-case {params.mask_lower}
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        /usr/bin/time -v -a -o {output.resources} mmseqs linclust \
            "$TMPDIR/sequences" "$TMPDIR/clusters" "$TMPDIR/work" \
            --min-seq-id {params.min_id} \
            -c {params.coverage} \
            --cov-mode {params.cov_mode} \
            -e {params.evalue} \
            --kmer-per-seq {params.kmers} \
            --spaced-kmer-mode {params.spaced} \
            --mask-lower-case {params.mask_lower} \
            --mask {params.mask} \
            --cluster-mode {params.cluster_mode} \
            --threads {threads}
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        /usr/bin/time -v -a -o {output.resources} mmseqs createtsv \
            "$TMPDIR/sequences" "$TMPDIR/sequences" "$TMPDIR/clusters" \
            {output.assignments}
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        /usr/bin/time -v -a -o {output.resources} mmseqs align \
            "$TMPDIR/sequences" "$TMPDIR/sequences" "$TMPDIR/clusters" \
            "$TMPDIR/forward_alignments" --alignment-mode 3 --threads {threads}
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        /usr/bin/time -v -a -o {output.resources} mmseqs createsubdb \
            "$TMPDIR/clusters" "$TMPDIR/sequences" "$TMPDIR/representatives"
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        /usr/bin/time -v -a -o {output.resources} mmseqs search \
            "$TMPDIR/representatives" "$TMPDIR/sequences" \
            "$TMPDIR/strand_alignments" "$TMPDIR/search_work" \
            --search-type 3 --strand 0 --add-self-matches 0 \
            --min-seq-id {params.min_id} -c {params.coverage} \
            --cov-mode {params.cov_mode} -e {params.evalue} \
            --mask-lower-case {params.mask_lower} --mask {params.mask} \
            -k {params.alignment_kmer} --alignment-mode 3 \
            --max-seqs {params.max_alignments} \
            --split-memory-limit {params.split_memory} --threads {threads}
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        /usr/bin/time -v -a -o {output.resources} mmseqs convertalis \
            "$TMPDIR/sequences" "$TMPDIR/sequences" \
            "$TMPDIR/forward_alignments" "$TMPDIR/forward_alignments.tsv" \
            --format-output "query,target,fident,alnlen,qcov,tcov,qstart,qend,tstart,tend,evalue,bits"
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        /usr/bin/time -v -a -o {output.resources} mmseqs convertalis \
            "$TMPDIR/representatives" "$TMPDIR/sequences" \
            "$TMPDIR/strand_alignments" "$TMPDIR/reverse_alignments.tsv" \
            --format-output "query,target,fident,alnlen,qcov,tcov,qstart,qend,tstart,tend,evalue,bits"
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        linclust-conservation-filter-alignments \
            --assignments {output.assignments} \
            --alignments "$TMPDIR/forward_alignments.tsv" \
            "$TMPDIR/reverse_alignments.tsv" \
            --output {output.alignments}
        """


rule summarize_smoke:
    input:
        stats=expand(f"{SMOKE}/windows/{{accession}}.json", accession=ACCESSIONS),
        manifest=f"{SMOKE}/assembly_manifest.tsv",
        release_gate=f"{CONTRACTS}/mmseqs2_release_gate.json",
        assignments=f"{SMOKE}/clusters.tsv",
        alignments=f"{SMOKE}/alignments.tsv",
        fasta=f"{SMOKE}/windows.fasta",
        version=f"{SMOKE}/mmseqs_version.txt",
        resources=f"{SMOKE}/resources.txt",
        peak_temporary_bytes=f"{SMOKE}/peak_temporary_bytes.txt",
    output:
        f"{SMOKE}/receipt.json",
    params:
        expected_version=str(MMSEQS["candidate_release"]),
        configuration=json.dumps(MMSEQS, sort_keys=True),
        pipeline_commit=PIPELINE_COMMIT,
        pipeline_config_sha256=PIPELINE_CONFIG_SHA256,
    shell:
        "linclust-conservation-summarize-smoke --stats {input.stats:q} "
        "--assignments {input.assignments:q} --alignments {input.alignments:q} "
        "--fasta {input.fasta:q} --mmseqs-version {input.version:q} "
        "--expected-mmseqs-version {params.expected_version:q} "
        "--configuration {params.configuration:q} "
        "--release-gate {input.release_gate:q} "
        "--pipeline-commit {params.pipeline_commit:q} "
        "--pipeline-config-sha256 {params.pipeline_config_sha256:q} "
        "--resources {input.resources:q} "
        "--peak-temporary-bytes {input.peak_temporary_bytes:q} --output {output:q}"


rule smoke:
