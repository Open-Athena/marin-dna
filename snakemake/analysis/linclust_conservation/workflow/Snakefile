rule run_background_seed_graph:
    input:
        fasta=f"{BACKGROUND_SCALING}/{{sample}}/fixture/windows.fasta",
        truth=f"{HOMOLOGY_TUNING}/fixture/truth.tsv",
    output:
        assignments=f"{SEED_GRAPH_BACKGROUND}/{{sample}}/{{variant}}/clusters.tsv",
        receipt=f"{SEED_GRAPH_BACKGROUND}/{{sample}}/{{variant}}/seed_graph.json",
        version=f"{SEED_GRAPH_BACKGROUND}/{{sample}}/{{variant}}/version.txt",
        resources=f"{SEED_GRAPH_BACKGROUND}/{{sample}}/{{variant}}/resources.txt",
    wildcard_constraints:
        sample="|".join(SEED_GRAPH_SAMPLE_NAMES) or "(?!x)x",
        variant="|".join(SEED_GRAPH_VARIANT_NAMES) or "(?!x)x",
    resources:
        mem_mb=110000,
    params:
        kmer_length=lambda wc: SEED_GRAPH_VARIANTS[wc.variant]["kmer_length"],
        selected_seeds=lambda wc: SEED_GRAPH_VARIANTS[wc.variant][
            "selected_seeds_per_sequence"
        ],
        max_frequency=lambda wc: SEED_GRAPH_VARIANTS[wc.variant]["max_seed_frequency"],
        min_shared=lambda wc: SEED_GRAPH_VARIANTS[wc.variant]["min_shared_seeds"],
        hash_seed=lambda wc: SEED_GRAPH_VARIANTS[wc.variant]["hash_seed"],
        timeout=lambda wc: SEED_GRAPH_VARIANTS[wc.variant]["timeout"],
        source_aliases=json.dumps(SEED_GRAPH_SOURCE_ALIASES, sort_keys=True),
    shell:
        r"""
        set -euo pipefail
        /usr/bin/time -v -o {output.resources} \
            timeout --signal=TERM {params.timeout} \
            linclust-conservation-build-seed-graph \
            --fasta {input.fasta:q} --truth {input.truth:q} \
            --assignments {output.assignments:q} --receipt {output.receipt:q} \
            --version {output.version:q} --kmer-length {params.kmer_length} \
            --selected-seeds {params.selected_seeds} \
            --max-seed-frequency {params.max_frequency} \
            --min-shared-seeds {params.min_shared} \
            --hash-seed {params.hash_seed} \
            --source-aliases {params.source_aliases:q}
        """


