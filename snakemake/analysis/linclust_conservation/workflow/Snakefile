rule summarize_homology_tuning:
    input:
        expand(
            f"{HOMOLOGY_TUNING}/{{variant}}/receipt.json",
            variant=TUNING_NAMES,
        ),
    output:
        json=f"{HOMOLOGY_TUNING}/summary.json",
        tsv=f"{HOMOLOGY_TUNING}/summary.tsv",
    run:
        rows = []
        for variant, path in zip(TUNING_NAMES, input, strict=True):
            receipt = json.loads(Path(path).read_text())
            configuration = receipt.pop("mmseqs_configuration")
            rows.append(
                {
                    "variant": variant,
                    "coverage": configuration["coverage"],
                    "min_sequence_identity": configuration["min_sequence_identity"],
                    "kmer_per_sequence_scale": configuration[
                        "kmer_per_sequence_scale"
                    ],
                    "spaced_kmer_mode": configuration["spaced_kmer_mode"],
                    "mask_lower_case": configuration["mask_lower_case"],
                    "low_complexity_masking": configuration[
                        "low_complexity_masking"
                    ],
                    **receipt,
                }
            )
        Path(output.json).write_text(
            json.dumps(rows, indent=2, sort_keys=True) + "\n"
        )
        pl.DataFrame(rows).select(
            "variant",
            "coverage",
            "min_sequence_identity",
            "kmer_per_sequence_scale",
            "spaced_kmer_mode",
            "mask_lower_case",
            "low_complexity_masking",
            "anchor_count",
            "sequence_count",
            "cluster_count",
            "cluster_count_over_ideal",
            "exact_anchor_recovery_fraction",
            "true_pair_recall",
            "pair_precision",
            "impure_cluster_count",
            "mean_true_edge_identity",
            "mean_true_edge_query_coverage",
            "mean_true_edge_target_coverage",
        ).write_csv(output.tsv, separator="\t")


