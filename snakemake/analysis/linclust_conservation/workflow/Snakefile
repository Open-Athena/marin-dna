rule run_seed_alignment_diagnostic:
    input:
        f"{SEED_ALIGNMENT_DIAGNOSTIC}/subset.fasta",
    output:
        alignments=f"{SEED_ALIGNMENT_DIAGNOSTIC}/alignments.tsv",
        version=f"{SEED_ALIGNMENT_DIAGNOSTIC}/mmseqs_version.txt",
        resources=f"{SEED_ALIGNMENT_DIAGNOSTIC}/resources.txt",
    conda:
        "envs/mmseqs2.yaml"
    threads: 4
    resources:
        mem_mb=16000,
    params:
        timeout=SEED_ALIGNMENT_CONFIG.get("timeout", "10m"),
        max_sequences=int(SEED_ALIGNMENT_CONFIG.get("max_sequences", 2000)),
    shell:
        r"""
        set -euo pipefail
        TMPDIR=$(mktemp -d -t seed_alignment_diagnostic_XXXXXX)
        trap 'rm -rf "$TMPDIR"' EXIT
        mmseqs version >{output.version}
        /usr/bin/time -v -o {output.resources} mmseqs createdb \
            {input:q} "$TMPDIR/sequences" --mask-lower-case 0
        /usr/bin/time -v -a -o {output.resources} \
            timeout --signal=TERM {params.timeout} mmseqs search \
            "$TMPDIR/sequences" "$TMPDIR/sequences" \
            "$TMPDIR/search" "$TMPDIR/work" \
            --search-type 3 --strand 1 --add-self-matches 1 \
            --prefilter-mode 2 --min-seq-id 0 -c 0 --cov-mode 0 -e 10000 \
            -s 7.5 --max-seqs {params.max_sequences} --spaced-kmer-mode 1 \
            --mask-lower-case 0 --mask 0 --alignment-mode 3 \
            --split-memory-limit 12G --threads {threads}
        /usr/bin/time -v -a -o {output.resources} mmseqs convertalis \
            "$TMPDIR/sequences" "$TMPDIR/sequences" "$TMPDIR/search" \
            {output.alignments:q} --format-output \
            "query,target,fident,alnlen,qcov,tcov,qstart,qend,tstart,tend,evalue,bits"
        """


