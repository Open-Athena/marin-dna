configfile: "config/config.yaml"


MMSEQS = config["mmseqs"]
ORDER_SEEDS = [str(seed) for seed in MMSEQS["order_seeds"]]
PIPELINE_COMMIT = resolve_pipeline_commit()
PIPELINE_CONFIG_SHA256 = configuration_sha256(config)
RESULTS = (
    f"results/{config['pipeline_version']}/{PIPELINE_COMMIT}/"
    f"{PIPELINE_CONFIG_SHA256}"
)
CONTRACTS = f"{RESULTS}/contracts"
MANIFEST = f"{RESULTS}/manifest"
SMOKE = f"{RESULTS}/smoke"
EXHAUSTIVE = f"{RESULTS}/exhaustive"
HOMOLOGY_TUNING = f"{RESULTS}/homology_tuning"
HOMOLOGY_SEARCH_CLUSTERING = f"{RESULTS}/homology_search_clustering"
HOMOLOGY_EXHAUSTIVE_GRAPH = f"{RESULTS}/homology_exhaustive_graph"

HOMOLOGY_FIXTURE = config.get("homology_fixture", {})
HOMOLOGY_SOURCES = HOMOLOGY_FIXTURE.get("sources", [])
HOMOLOGY_MAX_ANCHORS = int(HOMOLOGY_FIXTURE.get("max_anchors", 256))
HOMOLOGY_CANDIDATE_ANCHORS = int(
    HOMOLOGY_FIXTURE.get("candidate_anchors", HOMOLOGY_MAX_ANCHORS * 8)
)
HOMOLOGY_SEQUENCE_MODE = HOMOLOGY_FIXTURE.get("sequence_mode", "embedded")
HOMOLOGY_SELECTION_WINDOW_LENGTH = HOMOLOGY_FIXTURE.get("selection_window_length")
TUNING_VARIANTS = config.get("tuning", {}).get(
    "variants",
