rule run_homology_search_clustering:
    input:
        fasta=f"{HOMOLOGY_TUNING}/fixture/windows.fasta",
    output:
        assignments=f"{HOMOLOGY_SEARCH_CLUSTERING}/{{variant}}/clusters.tsv",
        alignments=f"{HOMOLOGY_SEARCH_CLUSTERING}/{{variant}}/alignments.tsv",
        version=f"{HOMOLOGY_SEARCH_CLUSTERING}/{{variant}}/mmseqs_version.txt",
        resources=f"{HOMOLOGY_SEARCH_CLUSTERING}/{{variant}}/resources.txt",
    wildcard_constraints:
        variant="|".join(SEARCH_CLUSTERING_NAMES),
    conda:
        "envs/mmseqs2.yaml"
    threads: 2
    resources:
        mem_mb=14000,
    params:
        sensitivity=lambda wc: SEARCH_CLUSTERING_VARIANTS[wc.variant]["sensitivity"],
        single_step=lambda wc: int(
            SEARCH_CLUSTERING_VARIANTS[wc.variant]["single_step_clustering"]
        ),
        reassign=lambda wc: int(
            SEARCH_CLUSTERING_VARIANTS[wc.variant]["cluster_reassign"]
        ),
        cluster_mode=lambda wc: SEARCH_CLUSTERING_VARIANTS[wc.variant]["cluster_mode"],
        min_id=lambda wc: SEARCH_CLUSTERING_VARIANTS[wc.variant][
            "min_sequence_identity"
        ],
        coverage=lambda wc: SEARCH_CLUSTERING_VARIANTS[wc.variant]["coverage"],
        max_sequences=lambda wc: SEARCH_CLUSTERING_VARIANTS[wc.variant]["max_sequences"],
        cov_mode=MMSEQS["coverage_mode"],
        evalue=MMSEQS["evalue"],
        spaced=lambda wc: SEARCH_CLUSTERING_VARIANTS[wc.variant].get(
            "spaced_kmer_mode", 1
        ),
        mask_lower=lambda wc: SEARCH_CLUSTERING_VARIANTS[wc.variant].get(
            "mask_lower_case", MMSEQS["mask_lower_case"]
        ),
        mask=lambda wc: SEARCH_CLUSTERING_VARIANTS[wc.variant].get(
            "low_complexity_masking", MMSEQS["low_complexity_masking"]
        ),
        split_memory=lambda wc: SEARCH_CLUSTERING_VARIANTS[wc.variant][
            "split_memory_limit"
        ],
    shell:
        r"""
        set -euo pipefail
        TMPDIR=$(mktemp -d -t search_cluster_homology_XXXXXX)
        trap 'rm -rf "$TMPDIR"' EXIT
        mmseqs version >{output.version}
        /usr/bin/time -v -o {output.resources} mmseqs createdb \
            {input.fasta} "$TMPDIR/sequences" \
            --mask-lower-case {params.mask_lower}
        /usr/bin/time -v -a -o {output.resources} mmseqs cluster \
            "$TMPDIR/sequences" "$TMPDIR/clusters" "$TMPDIR/work" \
            --min-seq-id {params.min_id} -c {params.coverage} \
            --cov-mode {params.cov_mode} -e {params.evalue} \
            -s {params.sensitivity} --max-seqs {params.max_sequences} \
            --spaced-kmer-mode {params.spaced} \
            --mask-lower-case {params.mask_lower} --mask {params.mask} \
            --cluster-mode {params.cluster_mode} \
            --single-step-clustering {params.single_step} \
            --cluster-reassign {params.reassign} \
            --split-memory-limit {params.split_memory} --threads {threads}
        /usr/bin/time -v -a -o {output.resources} mmseqs createtsv \
            "$TMPDIR/sequences" "$TMPDIR/sequences" "$TMPDIR/clusters" \
            {output.assignments}
        /usr/bin/time -v -a -o {output.resources} mmseqs align \
            "$TMPDIR/sequences" "$TMPDIR/sequences" "$TMPDIR/clusters" \
            "$TMPDIR/alignments" --alignment-mode 3 --threads {threads}
        /usr/bin/time -v -a -o {output.resources} mmseqs convertalis \
            "$TMPDIR/sequences" "$TMPDIR/sequences" "$TMPDIR/alignments" \
            {output.alignments} \
            --format-output \
            "query,target,fident,alnlen,qcov,tcov,qstart,qend,tstart,tend,evalue,bits"
        """


