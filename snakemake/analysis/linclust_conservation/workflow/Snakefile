rule summarize_background_seed_graph:
    input:
        evaluations=expand(
            f"{SEED_GRAPH_BACKGROUND}/{{sample}}/{{variant}}/receipt.json",
            sample=SEED_GRAPH_SAMPLE_NAMES,
            variant=SEED_GRAPH_VARIANT_NAMES,
        ),
        candidate_receipts=expand(
            f"{SEED_GRAPH_BACKGROUND}/{{sample}}/{{variant}}/seed_graph.json",
            sample=SEED_GRAPH_SAMPLE_NAMES,
            variant=SEED_GRAPH_VARIANT_NAMES,
        ),
    output:
        json=f"{SEED_GRAPH_BACKGROUND}/summary.json",
        tsv=f"{SEED_GRAPH_BACKGROUND}/summary.tsv",
    run:
        labels = [
            (sample, variant)
            for sample in SEED_GRAPH_SAMPLE_NAMES
            for variant in SEED_GRAPH_VARIANT_NAMES
        ]
        rows = []
        for (sample, variant), evaluation_path, candidate_path in zip(
            labels, input.evaluations, input.candidate_receipts, strict=True
        ):
            evaluation = json.loads(Path(evaluation_path).read_text())
            candidates = json.loads(Path(candidate_path).read_text())
            configuration = candidates["configuration"]
            rows.append(
                {
                    "sample": sample,
                    "variant": variant,
                    **configuration,
                    "candidate_true_pair_recall": candidates[
                        "candidate_true_pair_recall"
                    ],
                    "qualifying_candidate_pair_count": candidates[
                        "qualifying_candidate_pair_count"
                    ],
                    "accepted_edge_count": candidates["accepted_edge_count"],
                    "retained_seed_count": candidates["retained_seed_count"],
                    "suppressed_seed_count": candidates["suppressed_seed_count"],
                    "cluster_count": evaluation["cluster_count"],
                    "singleton_sequence_fraction": evaluation[
                        "singleton_sequence_fraction"
                    ],
                    "exact_anchor_recovery_fraction": evaluation[
                        "exact_anchor_recovery_fraction"
                    ],
                    "true_pair_recall": evaluation["true_pair_recall"],
                    "pair_precision": evaluation["pair_precision"],
                    "strict_truth_cluster_pair_precision": evaluation[
                        "strict_truth_cluster_pair_precision"
                    ],
                    "truth_record_decoy_contamination_fraction": evaluation[
                        "truth_record_decoy_contamination_fraction"
                    ],
                    "wall_seconds": evaluation["mmseqs_wall_seconds"],
                    "peak_rss_kib": evaluation["mmseqs_peak_rss_kib"],
                }
            )
        Path(output.json).write_text(
            json.dumps(rows, indent=2, sort_keys=True) + "\n"
        )
        pl.DataFrame(rows).write_csv(output.tsv, separator="\t")


