    shell:
        "linclust-conservation-source-inventory --manifest {input:q} "
        "--bucket {params.bucket:q} --prefix {params.prefix:q} "
        "--output {output.inventory:q} --missing-output {output.missing:q}"


rule resolve_pinned_manifest:
    input:
        genomes=f"{MANIFEST}/genomes.jsonl",
        taxonomy=f"{MANIFEST}/taxonomy.jsonl",
        version=f"{MANIFEST}/datasets_version.txt",
        retrieved_at=f"{MANIFEST}/retrieved_at.txt",
        inventory=f"{MANIFEST}/source_inventory.tsv",
        missing=f"{MANIFEST}/missing_sources.tsv",
    output:
        candidates=f"{MANIFEST}/assembly_candidates.tsv",
        selected=f"{MANIFEST}/assembly_manifest.tsv",
    run:
        missing = list(Path(input.missing).read_text().splitlines()[1:])
        assert not missing, (
            "selected accessions require fresh NCBI downloads before the pinned "
            f"manifest can be written: {missing}"
        )
        version = Path(input.version).read_text().strip()
        retrieved_at = Path(input.retrieved_at).read_text().strip()
        shell(
            "linclust-conservation-resolve-manifest "
            "--genomes {input.genomes:q} --taxonomy {input.taxonomy:q} "
            "--source-inventory {input.inventory:q} "
            "--datasets-version {version:q} --retrieved-at {retrieved_at:q} "
            "--candidates-output {output.candidates:q} "
            "--selected-output {output.selected:q}"
        )


rule write_selected_accessions:
    input:
        local(SELECTION_PATH),
    output:
        f"{MANIFEST}/selected_accessions.txt",
    run:
        accessions = pl.read_csv(input[0], separator="\t")["accession"].to_list()
        assert accessions == ACCESSIONS
        Path(output[0]).write_text(
            "".join(f"{accession}\n" for accession in accessions)
        )


