rule run_homology_linclust:
    input:
        fasta=f"{HOMOLOGY_TUNING}/fixture/windows.fasta",
    output:
        assignments=f"{HOMOLOGY_TUNING}/{{variant}}/clusters.tsv",
        alignments=f"{HOMOLOGY_TUNING}/{{variant}}/alignments.tsv",
        version=f"{HOMOLOGY_TUNING}/{{variant}}/mmseqs_version.txt",
        resources=f"{HOMOLOGY_TUNING}/{{variant}}/resources.txt",
    wildcard_constraints:
        variant="|".join(TUNING_NAMES),
    conda:
        "envs/mmseqs2.yaml"
    threads: 2
    resources:
        mem_mb=2000,
    params:
        min_id=lambda wc: TUNING_VARIANTS[wc.variant].get(
            "min_sequence_identity", MMSEQS["min_sequence_identity"]
        ),
        coverage=lambda wc: TUNING_VARIANTS[wc.variant]["coverage"],
        cov_mode=MMSEQS["coverage_mode"],
        evalue=MMSEQS["evalue"],
        kmers=lambda wc: TUNING_VARIANTS[wc.variant]["kmers_per_sequence"],
        kmer_scale=lambda wc: TUNING_VARIANTS[wc.variant]["kmer_per_sequence_scale"],
        spaced=lambda wc: TUNING_VARIANTS[wc.variant]["spaced_kmer_mode"],
        mask_lower=lambda wc: TUNING_VARIANTS[wc.variant].get(
            "mask_lower_case", MMSEQS["mask_lower_case"]
        ),
        mask=lambda wc: TUNING_VARIANTS[wc.variant].get(
            "low_complexity_masking", MMSEQS["low_complexity_masking"]
        ),
        cluster_mode=MMSEQS["cluster_mode"],
    shell:
        r"""
        set -euo pipefail
        TMPDIR=$(mktemp -d -t linclust_homology_XXXXXX)
        trap 'rm -rf "$TMPDIR"' EXIT
        mmseqs version >{output.version}
        /usr/bin/time -v -o {output.resources} mmseqs createdb \
            {input.fasta} "$TMPDIR/sequences" \
            --mask-lower-case {params.mask_lower}
        /usr/bin/time -v -a -o {output.resources} mmseqs linclust \
            "$TMPDIR/sequences" "$TMPDIR/clusters" "$TMPDIR/work" \
            --min-seq-id {params.min_id} -c {params.coverage} \
            --cov-mode {params.cov_mode} -e {params.evalue} \
            --kmer-per-seq {params.kmers} \
            --kmer-per-seq-scale {params.kmer_scale} \
            --spaced-kmer-mode {params.spaced} \
            --mask-lower-case {params.mask_lower} --mask {params.mask} \
            --cluster-mode {params.cluster_mode} --threads {threads}
        /usr/bin/time -v -a -o {output.resources} mmseqs createtsv \
            "$TMPDIR/sequences" "$TMPDIR/sequences" "$TMPDIR/clusters" \
            {output.assignments}
        /usr/bin/time -v -a -o {output.resources} mmseqs align \
            "$TMPDIR/sequences" "$TMPDIR/sequences" "$TMPDIR/clusters" \
            "$TMPDIR/alignments" --alignment-mode 3 --threads {threads}
        /usr/bin/time -v -a -o {output.resources} mmseqs convertalis \
            "$TMPDIR/sequences" "$TMPDIR/sequences" "$TMPDIR/alignments" \
            {output.alignments} \
            --format-output \
            "query,target,fident,alnlen,qcov,tcov,qstart,qend,tstart,tend,evalue,bits"
        """


