rule run_homology_exhaustive_graph:
    input:
        fasta=f"{HOMOLOGY_TUNING}/fixture/windows.fasta",
    output:
        assignments=f"{HOMOLOGY_EXHAUSTIVE_GRAPH}/{{variant}}/clusters.tsv",
        alignments=f"{HOMOLOGY_EXHAUSTIVE_GRAPH}/{{variant}}/alignments.tsv",
        version=f"{HOMOLOGY_EXHAUSTIVE_GRAPH}/{{variant}}/mmseqs_version.txt",
        resources=f"{HOMOLOGY_EXHAUSTIVE_GRAPH}/{{variant}}/resources.txt",
    wildcard_constraints:
        variant="|".join(EXHAUSTIVE_GRAPH_NAMES),
    conda:
        "envs/mmseqs2.yaml"
    threads: 2
    resources:
        mem_mb=14000,
    params:
        prefilter_mode=lambda wc: EXHAUSTIVE_GRAPH_VARIANTS[wc.variant][
            "prefilter_mode"
        ],
        sensitivity=lambda wc: EXHAUSTIVE_GRAPH_VARIANTS[wc.variant]["sensitivity"],
        cluster_mode=lambda wc: EXHAUSTIVE_GRAPH_VARIANTS[wc.variant]["cluster_mode"],
        min_id=lambda wc: EXHAUSTIVE_GRAPH_VARIANTS[wc.variant]["min_sequence_identity"],
        coverage=lambda wc: EXHAUSTIVE_GRAPH_VARIANTS[wc.variant]["coverage"],
        max_sequences=lambda wc: EXHAUSTIVE_GRAPH_VARIANTS[wc.variant]["max_sequences"],
        cov_mode=MMSEQS["coverage_mode"],
        evalue=MMSEQS["evalue"],
        spaced=lambda wc: EXHAUSTIVE_GRAPH_VARIANTS[wc.variant].get(
            "spaced_kmer_mode", 1
        ),
        mask_lower=lambda wc: EXHAUSTIVE_GRAPH_VARIANTS[wc.variant].get(
            "mask_lower_case", MMSEQS["mask_lower_case"]
        ),
        mask=lambda wc: EXHAUSTIVE_GRAPH_VARIANTS[wc.variant].get(
            "low_complexity_masking", MMSEQS["low_complexity_masking"]
        ),
        split_memory=lambda wc: EXHAUSTIVE_GRAPH_VARIANTS[wc.variant][
            "split_memory_limit"
        ],
        timeout=lambda wc: EXHAUSTIVE_GRAPH_VARIANTS[wc.variant].get("timeout", "10m"),
    shell:
        r"""
        set -euo pipefail
        TMPDIR=$(mktemp -d -t exhaustive_graph_homology_XXXXXX)
        trap 'rm -rf "$TMPDIR"' EXIT
        mmseqs version >{output.version}
        /usr/bin/time -v -o {output.resources} mmseqs createdb \
            {input.fasta} "$TMPDIR/sequences" \
            --mask-lower-case {params.mask_lower}
        /usr/bin/time -v -a -o {output.resources} \
            timeout --signal=TERM {params.timeout} mmseqs search \
            "$TMPDIR/sequences" "$TMPDIR/sequences" \
            "$TMPDIR/search" "$TMPDIR/work" \
            --search-type 3 --strand 1 --add-self-matches 1 \
            --prefilter-mode {params.prefilter_mode} \
            --min-seq-id {params.min_id} -c {params.coverage} \
            --cov-mode {params.cov_mode} -e {params.evalue} \
            -s {params.sensitivity} --max-seqs {params.max_sequences} \
            --spaced-kmer-mode {params.spaced} \
            --mask-lower-case {params.mask_lower} --mask {params.mask} \
            --alignment-mode 3 --split-memory-limit {params.split_memory} \
            --threads {threads}
        /usr/bin/time -v -a -o {output.resources} mmseqs clust \
            "$TMPDIR/sequences" "$TMPDIR/search" "$TMPDIR/clusters" \
            --cluster-mode {params.cluster_mode} --threads {threads}
        /usr/bin/time -v -a -o {output.resources} mmseqs createtsv \
            "$TMPDIR/sequences" "$TMPDIR/sequences" "$TMPDIR/clusters" \
            {output.assignments}
        /usr/bin/time -v -a -o {output.resources} mmseqs align \
            "$TMPDIR/sequences" "$TMPDIR/sequences" "$TMPDIR/clusters" \
            "$TMPDIR/cluster_alignments" --alignment-mode 3 --threads {threads}
        /usr/bin/time -v -a -o {output.resources} mmseqs convertalis \
            "$TMPDIR/sequences" "$TMPDIR/sequences" \
            "$TMPDIR/cluster_alignments" {output.alignments} \
            --format-output \
            "query,target,fident,alnlen,qcov,tcov,qstart,qend,tstart,tend,evalue,bits"
        """


