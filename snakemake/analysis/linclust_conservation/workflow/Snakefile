            "kmers_per_sequence": MMSEQS["kmers_per_sequence"],
            "kmer_per_sequence_scale": 0.2,
            "spaced_kmer_mode": MMSEQS["spaced_kmer_mode"],
        }
    },
)
TUNING_NAMES = sorted(TUNING_VARIANTS)
SEARCH_CLUSTERING_VARIANTS = config.get("search_clustering", {}).get(
    "variants",
    {
        "single_s75_setcover": {
            "workflow": "single_step",
            "sensitivity": 7.5,
            "single_step_clustering": True,
            "cluster_reassign": False,
