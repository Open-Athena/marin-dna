        resources=f"{CONTRACTS}/order_{{order_seed}}/resources.txt",
    conda:
        "envs/mmseqs2.yaml"
    threads: 2
    resources:
        mem_mb=2000,
    params:
        min_id=MMSEQS["min_sequence_identity"],
        coverage=MMSEQS["coverage"],
        cov_mode=MMSEQS["coverage_mode"],
