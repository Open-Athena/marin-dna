import json
import shutil
from pathlib import Path

import polars as pl

from marin_dna_linclust_conservation.controls import (
    canonical_partition,
    check_release_gate,
    synthetic_sequences,
)
from marin_dna_linclust_conservation.manifest import (
    MANIFEST_COLUMNS,
    validate_pinned_manifest,
)


configfile: "config/config.yaml"


MMSEQS = config["mmseqs"]
ORDER_SEEDS = [str(seed) for seed in MMSEQS["order_seeds"]]
CONTRACTS = "results/contracts"
MANIFEST = "results/manifest"
SMOKE = "results/smoke"

SELECTION_PATH = "config/assembly_selection.tsv"
SOURCE_REUSE_PATH = "config/source_reuse_inventory.tsv"
SELECTION = pl.read_csv(SELECTION_PATH, separator="\t")
ACCESSIONS = SELECTION["accession"].to_list()
SOURCE_REUSE = {
    row["accession"]: row
    for row in pl.read_csv(SOURCE_REUSE_PATH, separator="\t").to_dicts()
}
SMOKE_MAX_WINDOWS = config["smoke"]["candidates_per_assembly"] * len(ACCESSIONS)
SYNTHETIC_RECORD_COUNT = len(synthetic_sequences())
STAGING_PREFIX = config["staging"]["destination_prefix"].strip("/")
STAGING_BUCKET = config["staging"]["destination_bucket"]


def staging_destination(accession):
    return f"s3://{STAGING_BUCKET}/{STAGING_PREFIX}/{accession}.2bit"


def staging_source_options(accession):
    source = SOURCE_REUSE.get(accession)
    if source is None:
        return ""
    return (
        f"--source-uri {source['download_uri']} "
        f"--source-etag {source['source_checksum']} "
        f"--source-size-bytes {source['source_size_bytes']}"
    )


rule all:
    input:
        f"{CONTRACTS}/mmseqs2_release_gate.json",


rule query_mammal_genomes:
    output:
        genomes=f"{MANIFEST}/genomes.jsonl",
        version=f"{MANIFEST}/datasets_version.txt",
        retrieved_at=f"{MANIFEST}/retrieved_at.txt",
    conda:
        "envs/ncbi_datasets.yaml"
    params:
        taxon=config["manifest"]["taxon"],
        version=str(config["manifest"]["datasets_version"]),
        reference="--reference" if config["manifest"]["query_reference_only"] else "",
    shell:
        r"""
        set -euo pipefail
        test "$(datasets version | awk '{{print $3}}')" = "{params.version}"
        datasets version | awk '{{print $3}}' >{output.version}
        date -u +%Y-%m-%dT%H:%M:%SZ >{output.retrieved_at}
        datasets summary genome taxon {params.taxon} \
            --as-json-lines {params.reference} --annotated --exclude-atypical \
            --assembly-source RefSeq >{output.genomes}
        test -s {output.genomes}
        """


rule extract_manifest_tax_ids:
    input:
        f"{MANIFEST}/genomes.jsonl",
    output:
        f"{MANIFEST}/tax_ids.txt",
    run:
        tax_ids = set()
        with Path(input[0]).open() as handle:
            for line in handle:
                if line.strip():
                    tax_ids.add(int(json.loads(line)["organism"]["tax_id"]))
        assert tax_ids, "NCBI genome query returned no taxonomic IDs"
        Path(output[0]).write_text(
            "".join(f"{tax_id}\n" for tax_id in sorted(tax_ids))
        )


rule query_manifest_taxonomy:
    input:
        f"{MANIFEST}/tax_ids.txt",
    output:
        f"{MANIFEST}/taxonomy.jsonl",
    conda:
        "envs/ncbi_datasets.yaml"
    shell:
        "datasets summary taxonomy taxon --inputfile {input} --as-json-lines > {output}"


rule resolve_provisional_manifest:
    input:
        genomes=f"{MANIFEST}/genomes.jsonl",
        taxonomy=f"{MANIFEST}/taxonomy.jsonl",
        version=f"{MANIFEST}/datasets_version.txt",
        retrieved_at=f"{MANIFEST}/retrieved_at.txt",
    output:
        candidates=f"{MANIFEST}/provisional_candidates.tsv",
        selected=f"{MANIFEST}/provisional_selected.tsv",
    run:
        version = Path(input.version).read_text().strip()
        retrieved_at = Path(input.retrieved_at).read_text().strip()
        shell(
            "linclust-conservation-resolve-manifest "
            "--genomes {input.genomes:q} --taxonomy {input.taxonomy:q} "
            "--datasets-version {version:q} --retrieved-at {retrieved_at:q} "
            "--candidates-output {output.candidates:q} "
            "--selected-output {output.selected:q}"
        )


rule audit_existing_genome_mirror:
    input:
        f"{MANIFEST}/provisional_selected.tsv",
    output:
        inventory=f"{MANIFEST}/source_inventory.tsv",
        missing=f"{MANIFEST}/missing_sources.tsv",
    params:
        bucket=config["manifest"]["source_bucket"],
        prefix=config["manifest"]["source_prefix"],
    shell:
        "linclust-conservation-source-inventory --manifest {input:q} "
        "--bucket {params.bucket:q} --prefix {params.prefix:q} "
        "--output {output.inventory:q} --missing-output {output.missing:q}"


rule resolve_pinned_manifest:
    input:
        genomes=f"{MANIFEST}/genomes.jsonl",
        taxonomy=f"{MANIFEST}/taxonomy.jsonl",
        version=f"{MANIFEST}/datasets_version.txt",
        retrieved_at=f"{MANIFEST}/retrieved_at.txt",
        inventory=f"{MANIFEST}/source_inventory.tsv",
        missing=f"{MANIFEST}/missing_sources.tsv",
    output:
        candidates=f"{MANIFEST}/assembly_candidates.tsv",
        selected=f"{MANIFEST}/assembly_manifest.tsv",
    run:
        missing = list(Path(input.missing).read_text().splitlines()[1:])
        assert not missing, (
            "selected accessions require fresh NCBI downloads before the pinned "
            f"manifest can be written: {missing}"
        )
        version = Path(input.version).read_text().strip()
        retrieved_at = Path(input.retrieved_at).read_text().strip()
        shell(
            "linclust-conservation-resolve-manifest "
            "--genomes {input.genomes:q} --taxonomy {input.taxonomy:q} "
            "--source-inventory {input.inventory:q} "
            "--datasets-version {version:q} --retrieved-at {retrieved_at:q} "
            "--candidates-output {output.candidates:q} "
            "--selected-output {output.selected:q}"
        )


rule write_selected_accessions:
    input:
        local(SELECTION_PATH),
    output:
        f"{MANIFEST}/selected_accessions.txt",
    run:
        accessions = pl.read_csv(input[0], separator="\t")["accession"].to_list()
        assert accessions == ACCESSIONS
        Path(output[0]).write_text(
            "".join(f"{accession}\n" for accession in accessions)
        )


rule query_selected_sequence_report:
    input:
        f"{MANIFEST}/selected_accessions.txt",
    output:
        report=f"{MANIFEST}/sequence_report.jsonl",
        version=f"{MANIFEST}/sequence_report_datasets_version.txt",
        retrieved_at=f"{MANIFEST}/sequence_report_retrieved_at.txt",
    conda:
        "envs/ncbi_datasets.yaml"
    params:
        version=str(config["manifest"]["datasets_version"]),
    shell:
        r"""
        set -euo pipefail
        test "$(datasets version | awk '{{print $3}}')" = "{params.version}"
        datasets version | awk '{{print $3}}' >{output.version}
        date -u +%Y-%m-%dT%H:%M:%SZ >{output.retrieved_at}
        datasets summary genome accession --inputfile {input} \
            --report sequence --as-json-lines >{output.report}
        test -s {output.report}
        """


rule stage_genome:
    input:
        selection=local(SELECTION_PATH),
        reuse=local(SOURCE_REUSE_PATH),
    output:
        f"{SMOKE}/staging/{{accession}}.json",
    wildcard_constraints:
        accession="|".join(ACCESSIONS).replace(".", r"\."),
    conda:
        "envs/genome_tools.yaml"
    resources:
        mem_mb=3000,
        staging_jobs=1,
    params:
        destination=lambda wildcards: staging_destination(wildcards.accession),
        source_options=lambda wildcards: staging_source_options(wildcards.accession),
    shell:
        "linclust-conservation-stage-genome --accession {wildcards.accession:q} "
        "--destination-uri {params.destination:q} {params.source_options} "
        "--output {output:q}"


rule sample_genome_windows:
    input:
        staging=f"{SMOKE}/staging/{{accession}}.json",
        sequence_report=f"{MANIFEST}/sequence_report.jsonl",
    output:
        fasta=f"{SMOKE}/windows/{{accession}}.fasta",
        stats=f"{SMOKE}/windows/{{accession}}.json",
    conda:
        "envs/genome_tools.yaml"
    resources:
        mem_mb=3000,
        sampling_jobs=1,
    params:
        length=config["window"]["length"],
        stride=config["window"]["stride"],
        repeat=config["window"]["max_repeat_fraction"],
        candidate_count=config["smoke"]["candidates_per_assembly"],
        seed=config["smoke"]["seed"],
    shell:
        "linclust-conservation-sample-genome "
        "--accession {wildcards.accession:q} "
        "--sequence-report {input.sequence_report:q} "
        "--staging-receipt {input.staging:q} "
        "--window-length {params.length} --stride {params.stride} "
        "--candidate-count {params.candidate_count} --seed {params.seed} "
        "--max-repeat-fraction {params.repeat} "
        "--output-fasta {output.fasta:q} --output-stats {output.stats:q}"


rule combine_smoke_windows:
    input:
        expand(f"{SMOKE}/windows/{{accession}}.fasta", accession=ACCESSIONS),
    output:
        f"{SMOKE}/windows.fasta",
    run:
        Path(output[0]).parent.mkdir(parents=True, exist_ok=True)
        with Path(output[0]).open("wb") as destination:
            for path in input:
                with Path(path).open("rb") as source:
                    shutil.copyfileobj(source, destination)


rule finalize_staged_manifest:
    input:
        selection=local(SELECTION_PATH),
        staging=expand(f"{SMOKE}/staging/{{accession}}.json", accession=ACCESSIONS),
        stats=expand(f"{SMOKE}/windows/{{accession}}.json", accession=ACCESSIONS),
    output:
        f"{SMOKE}/assembly_manifest.tsv",
    run:
        staged = {
            json.loads(Path(path).read_text())["accession"]: json.loads(
                Path(path).read_text()
            )
            for path in input.staging
        }
        stats = {
            json.loads(Path(path).read_text())["accession"]: json.loads(
                Path(path).read_text()
            )
            for path in input.stats
        }
        rows = []
        for row in pl.read_csv(input.selection, separator="\t").to_dicts():
            accession = row["accession"]
            receipt = staged[accession]
            row.update(
                {
                    "download_uri": receipt["destination_uri"],
                    "source_checksum_type": "sha256",
                    "source_checksum": stats[accession]["sequence_sha256"],
                    "source_size_bytes": receipt["destination_size_bytes"],
                    "sequence_sha256": stats[accession]["sequence_sha256"],
                }
            )
            rows.append(row)
        manifest = pl.DataFrame(rows).select(MANIFEST_COLUMNS)
        validate_pinned_manifest(manifest)
        manifest.write_csv(output[0], separator="\t")


rule run_smoke_linclust:
    input:
        fasta=f"{SMOKE}/windows.fasta",
    output:
        assignments=f"{SMOKE}/clusters.tsv",
        alignments=f"{SMOKE}/alignments.tsv",
        version=f"{SMOKE}/mmseqs_version.txt",
        resources=f"{SMOKE}/resources.txt",
        peak_temporary_bytes=f"{SMOKE}/peak_temporary_bytes.txt",
    conda:
        "envs/mmseqs2.yaml"
    threads: 2
    resources:
        mem_mb=6000,
    params:
        min_id=MMSEQS["min_sequence_identity"],
        coverage=MMSEQS["coverage"],
        cov_mode=MMSEQS["coverage_mode"],
        evalue=MMSEQS["evalue"],
        kmers=MMSEQS["kmers_per_sequence"],
        spaced=MMSEQS["spaced_kmer_mode"],
        mask_lower=MMSEQS["mask_lower_case"],
        mask=MMSEQS["low_complexity_masking"],
        cluster_mode=MMSEQS["cluster_mode"],
        max_alignments=SMOKE_MAX_WINDOWS,
        alignment_kmer=MMSEQS["alignment_kmer_length"],
        split_memory=MMSEQS["alignment_split_memory_limit"],
    shell:
        r"""
        set -euo pipefail
        TMPDIR=$(mktemp -d -t linclust_smoke_XXXXXX)
        trap 'rm -rf "$TMPDIR"' EXIT
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        mmseqs version >{output.version}
        /usr/bin/time -v -o {output.resources} \
            mmseqs createdb {input.fasta} "$TMPDIR/sequences" \
            --mask-lower-case {params.mask_lower}
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        /usr/bin/time -v -a -o {output.resources} mmseqs linclust \
            "$TMPDIR/sequences" "$TMPDIR/clusters" "$TMPDIR/work" \
            --min-seq-id {params.min_id} \
            -c {params.coverage} \
            --cov-mode {params.cov_mode} \
            -e {params.evalue} \
            --kmer-per-seq {params.kmers} \
            --spaced-kmer-mode {params.spaced} \
            --mask-lower-case {params.mask_lower} \
            --mask {params.mask} \
            --cluster-mode {params.cluster_mode} \
            --threads {threads}
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        /usr/bin/time -v -a -o {output.resources} mmseqs createtsv \
            "$TMPDIR/sequences" "$TMPDIR/sequences" "$TMPDIR/clusters" \
            {output.assignments}
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        /usr/bin/time -v -a -o {output.resources} mmseqs align \
            "$TMPDIR/sequences" "$TMPDIR/sequences" "$TMPDIR/clusters" \
            "$TMPDIR/forward_alignments" --alignment-mode 3 --threads {threads}
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        /usr/bin/time -v -a -o {output.resources} mmseqs createsubdb \
            "$TMPDIR/clusters" "$TMPDIR/sequences" "$TMPDIR/representatives"
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        /usr/bin/time -v -a -o {output.resources} mmseqs search \
            "$TMPDIR/representatives" "$TMPDIR/sequences" \
            "$TMPDIR/strand_alignments" "$TMPDIR/search_work" \
            --search-type 3 --strand 0 --add-self-matches 0 \
            --min-seq-id {params.min_id} -c {params.coverage} \
            --cov-mode {params.cov_mode} -e {params.evalue} \
            --mask-lower-case {params.mask_lower} --mask {params.mask} \
            -k {params.alignment_kmer} --alignment-mode 3 \
            --max-seqs {params.max_alignments} \
            --split-memory-limit {params.split_memory} --threads {threads}
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        /usr/bin/time -v -a -o {output.resources} mmseqs convertalis \
            "$TMPDIR/sequences" "$TMPDIR/sequences" \
            "$TMPDIR/forward_alignments" "$TMPDIR/forward_alignments.tsv" \
            --format-output "query,target,fident,alnlen,qcov,tcov,qstart,qend,tstart,tend,evalue,bits"
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        /usr/bin/time -v -a -o {output.resources} mmseqs convertalis \
            "$TMPDIR/representatives" "$TMPDIR/sequences" \
            "$TMPDIR/strand_alignments" "$TMPDIR/reverse_alignments.tsv" \
            --format-output "query,target,fident,alnlen,qcov,tcov,qstart,qend,tstart,tend,evalue,bits"
        linclust-conservation-record-peak \
            --directory "$TMPDIR" --output {output.peak_temporary_bytes}
        linclust-conservation-filter-alignments \
            --assignments {output.assignments} \
            --alignments "$TMPDIR/forward_alignments.tsv" \
            "$TMPDIR/reverse_alignments.tsv" \
            --output {output.alignments}
        """


rule summarize_smoke:
    input:
        stats=expand(f"{SMOKE}/windows/{{accession}}.json", accession=ACCESSIONS),
        manifest=f"{SMOKE}/assembly_manifest.tsv",
        assignments=f"{SMOKE}/clusters.tsv",
        alignments=f"{SMOKE}/alignments.tsv",
        fasta=f"{SMOKE}/windows.fasta",
        version=f"{SMOKE}/mmseqs_version.txt",
        resources=f"{SMOKE}/resources.txt",
        peak_temporary_bytes=f"{SMOKE}/peak_temporary_bytes.txt",
    output:
        f"{SMOKE}/receipt.json",
    shell:
        "linclust-conservation-summarize-smoke --stats {input.stats:q} "
        "--assignments {input.assignments:q} --alignments {input.alignments:q} "
        "--fasta {input.fasta:q} --mmseqs-version {input.version:q} "
        "--resources {input.resources:q} "
        "--peak-temporary-bytes {input.peak_temporary_bytes:q} --output {output:q}"


rule smoke:
    input:
        f"{SMOKE}/receipt.json",
        f"{SMOKE}/assembly_manifest.tsv",


