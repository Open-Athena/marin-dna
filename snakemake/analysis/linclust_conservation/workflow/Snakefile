rule check_synthetic_linclust:
    input:
        assignments=f"{CONTRACTS}/order_{{order_seed}}/clusters.tsv",
        alignments=f"{CONTRACTS}/order_{{order_seed}}/alignments.tsv",
        version=f"{CONTRACTS}/order_{{order_seed}}/mmseqs_version.txt",
    output:
        f"{CONTRACTS}/order_{{order_seed}}/release_gate.json",
    run:
        receipt = check_release_gate(input.assignments, input.alignments)
        receipt["mmseqs_version"] = Path(input.version).read_text().strip()
        receipt["order_seed"] = int(wildcards.order_seed)
        receipt["configuration"] = MMSEQS
        Path(output[0]).write_text(
            json.dumps(receipt, indent=2, sort_keys=True) + "\n"
        )


rule compare_synthetic_orderings:
    input:
        assignments=expand(
            f"{CONTRACTS}/order_{{order_seed}}/clusters.tsv",
            order_seed=ORDER_SEEDS,
        ),
        receipts=expand(
            f"{CONTRACTS}/order_{{order_seed}}/release_gate.json",
            order_seed=ORDER_SEEDS,
        ),
    output:
        f"{CONTRACTS}/mmseqs2_release_gate.json",
    run:
        partitions = [canonical_partition(path) for path in input.assignments]
        stable = all(partition == partitions[0] for partition in partitions[1:])
        assert stable, "synthetic cluster partition changes with input ordering"
        receipts = [json.loads(Path(path).read_text()) for path in input.receipts]
        versions = {receipt["mmseqs_version"] for receipt in receipts}
        assert versions == {str(MMSEQS["candidate_release"])}, versions
        combined = {
            "release_gate_passed": True,
            "assignment_partition_stable": True,
            "mmseqs_version": next(iter(versions)),
            "order_seeds": [int(seed) for seed in ORDER_SEEDS],
            "configuration": MMSEQS,
            "runs": receipts,
        }
        Path(output[0]).write_text(
            json.dumps(combined, indent=2, sort_keys=True) + "\n"
        )
