STAGING_PREFIX = config["staging"]["destination_prefix"].strip("/")
STAGING_BUCKET = config["staging"]["destination_bucket"]


def staging_destination(accession):
    return (
        f"s3://{STAGING_BUCKET}/{STAGING_PREFIX}/{config['pipeline_version']}/"
        f"{PIPELINE_COMMIT}/{PIPELINE_CONFIG_SHA256}/{accession}.2bit"
    )


def staging_source_options(accession):
    source = SOURCE_REUSE.get(accession)
    if source is None:
        return ""
    return (
        f"--source-uri {source['download_uri']} "
        f"--source-etag {source['source_checksum']} "
        f"--source-size-bytes {source['source_size_bytes']}"
    )


def candidate_selection_options():
    if CANDIDATES_PER_ASSEMBLY == "all":
        return "--all-windows"
    return f"--candidate-count {CANDIDATES_PER_ASSEMBLY}"


