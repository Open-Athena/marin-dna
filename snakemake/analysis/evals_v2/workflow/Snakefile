rule all:
    input:
        [
            f"results/metrics/{m['name']}/{d}.parquet"
            for m in config["models"]
            for d in get_model_datasets(m["name"])
        ]
        + (
            [
                "results/analysis/home_rank_trajectory.parquet",
                "results/analysis/home_rank_persistence.parquet",
            ]
            if "home_rank" in config
            else []
        ),
